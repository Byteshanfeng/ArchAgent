# 复制为 .env，填写真实模型名和密钥；不要提交 .env。
# 每家服务可有多个带编号的 CHAT_MODEL / IMAGE_MODEL 条目。
OPENAI_API_KEY=
GEMINI_API_KEY=

CHAT_MODEL_1_ID=openai-chat
CHAT_MODEL_1_LABEL="OpenAI 对话"
CHAT_MODEL_1_PROVIDER=openai-compatible
CHAT_MODEL_1_BASE_URL=https://api.openai.com/v1
CHAT_MODEL_1_MODEL=YOUR_CHAT_MODEL
CHAT_MODEL_1_API_KEY_ENV=OPENAI_API_KEY

CHAT_MODEL_2_ID=gemini-chat
CHAT_MODEL_2_LABEL="Gemini 对话"
CHAT_MODEL_2_PROVIDER=openai-compatible
CHAT_MODEL_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CHAT_MODEL_2_MODEL=YOUR_GEMINI_CHAT_MODEL
CHAT_MODEL_2_API_KEY_ENV=GEMINI_API_KEY

IMAGE_MODEL_1_ID=openai-image
IMAGE_MODEL_1_LABEL="OpenAI 生图"
IMAGE_MODEL_1_PROVIDER=openai-images
IMAGE_MODEL_1_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL_1_MODEL=YOUR_IMAGE_MODEL
IMAGE_MODEL_1_API_KEY_ENV=OPENAI_API_KEY

IMAGE_MODEL_2_ID=gemini-image
IMAGE_MODEL_2_LABEL="Gemini 生图"
IMAGE_MODEL_2_PROVIDER=gemini
IMAGE_MODEL_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta
IMAGE_MODEL_2_MODEL=YOUR_GEMINI_IMAGE_MODEL
IMAGE_MODEL_2_API_KEY_ENV=GEMINI_API_KEY

# 每个模型也可直接使用 CHAT_MODEL_1_API_KEY=... / IMAGE_MODEL_1_API_KEY=...
PORT=3488
HOST=127.0.0.1
PYTHON_BIN=python3
